# syntax=docker/dockerfile:1

# Build stage
FROM node:26-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies. The npm cache mount persists downloaded tarballs
# across builds (including CI runs, via the gha cache backend in
# docker.yml), so a partial package-lock.json change only re-fetches the
# packages that actually changed instead of the whole tree.
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci

# Copy source
COPY frontend ./

# Build
RUN npm run build

# Production stage
FROM node:26-alpine

WORKDIR /app

# Install a simple HTTP server to serve static files
RUN npm install -g serve

# Copy built app from builder
COPY --from=builder /app/output ./output

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {if (r.statusCode !== 200) throw new Error(r.statusCode)})"

# Start the app
CMD ["serve", "-s", "output", "-l", "3000"]
